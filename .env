# Please enter your local input, output and working dir

# input dir: input folder with your DUP-Pipeline output
KALIUM_DATA_PATH=./input

# output dir: main output folder.
KALIUM_OUTPUT_PATH=./output

# a working dir to store temp database files
KALIUM_WORKING_PATH=./

# name of the used CRTDL (Kalium360_CRTDL_basis or Kalium360_CRTDL_complex)
KALIUM_CRTDL=

# the pseudonym you used in the project survey
KALIUM_SITE_PSEUDONYM=
